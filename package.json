{
  "name": "veo-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "tsc && vite build --base ./ && rm -rf docs && mkdir -p docs && cp -r dist/* docs/ && cp dist/index.html dist/404.html && cp dist/index.html docs/404.html && cp public/.nojekyll dist/.nojekyll && cp public/.nojekyll docs/.nojekyll && python3 package_zip.py",
    "pack": "python3 package_zip.py",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^2.0.0"
  }
}
